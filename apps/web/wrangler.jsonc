// The website: static files only, with no server code. Serving them is free on Workers.
// Deploy: pnpm --filter @ivibe/web run deploy
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ivibe-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Every page has its own file (scripts/prerender.mjs); anything else is a real 404.
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "ivibe.tech", "custom_domain": true },
    { "pattern": "www.ivibe.tech", "custom_domain": true },
  ],
}
