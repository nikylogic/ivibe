# Copy to .env (never commit .env). Used by the spikes in spikes/ and by local development.

# Meta Model API key from https://dev.meta.ai (starts with LLM_)
META_API_KEY=
# Optional override; defaults to https://api.meta.ai/v1
META_API_BASE_URL=

# Baseten (Muse Spark Open), once credits are granted
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
